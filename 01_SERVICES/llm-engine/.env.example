# UDITO LLM server — configuration
# Copy to `.env` and adjust per-tier. See ARCHITECTURE.md §7.3.

# server | local  — influences model + memory defaults
UDITO_TIER=server

# OpenAI-compatible inference endpoint (Ollama | llama.cpp-server | vLLM | TGI)
LLM_BASE_URL=http://ollama:11434/v1
LLM_API_KEY=ollama
# Servidor con GPU: qwen3:4b-instruct-2507-q4_K_M (evaluado 2026-11-09, docs/RAG_NORMATIVA.md §8).
# CPU / Jetson: qwen2.5:0.5b-instruct (ver docker-compose.local.yml).
LLM_MODEL=qwen3:4b-instruct-2507-q4_K_M
LLM_WARMUP_ON_START=true
LLM_MAX_TOKENS_DEFAULT=80

# Memory — leave REDIS_URL unset on the local tier to use InMemoryStore
REDIS_URL=redis://redis:6379/0
MEMORY_WINDOW_SIZE=8
MEMORY_TTL_SECONDS=86400

# /v2/turn (cognitive_language). Claves de API separadas por comas; vacío = sin clave (solo desarrollo).
# Generar una: python3 -c "import secrets; print(secrets.token_urlsafe(24))"
LLM_API_KEYS=
TURN_MAX_HISTORY=16
TURN_MAX_CONTEXT_CHARS=6000
TURN_MAX_TOKENS_CAP=400
TURN_TEMPERATURE=0.3

# HTTP
API_PORT=8080
CORS_ALLOW_ORIGINS=*

# Logging
LOG_LEVEL=INFO
