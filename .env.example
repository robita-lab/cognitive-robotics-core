# Servidor cerebro (LAN). Copiar a .env en el servidor.
WHISPER_MODEL=small

# En la Jetson (etapa 2): IP del servidor en la red local
ROBITA_SERVER_URL=http://192.168.1.100:8000

# Textos hablados (saludo, despedida, Q&A): editar 04_KNOWLEDGE_CORE/responses/
ROBITA_KNOWLEDGE_CORE=/opt/robita-lab/04_KNOWLEDGE_CORE
# Lab udito-309: mic USB=4
# Altavoz: default (PC) o plughw:3,0 (ReSpeaker robot). Probar: ./scripts/test-audio.sh
ROBITA_AUDIO_INPUT=4
ROBITA_AUDIO_OUTPUT=default
