# =============================================================================
# Robita-Lab / UDITO — variables de entorno (copiar a .env)
#   cp .env.example .env
# =============================================================================

# --- Modo online (archivado en _archive/modo-online/) ---
# ROBITA_SERVER_URL=http://192.168.1.100:8000

# --- Jetson offline (standalone) — ver DEPLOY_JETSON_OFFLINE.md ---
# ROBITA_RAG_CONFIG=/opt/robita-lab/01_SERVICES/rag-engine/config/rag_config.jetson.json
# HF_HOME=/opt/robita-lab/data/huggingface

# Textos hablados (saludo, despedida, Q&A)
ROBITA_KNOWLEDGE_CORE=/opt/robita-lab/04_KNOWLEDGE_CORE

# STT (servidor o standalone; en Jetson usar tiny)
WHISPER_MODEL=small

# RAM / preparación pipeline (./UDITO)
ROBITA_LOW_MEMORY=1
ROBITA_RELEASE_MODELS=1
ROBITA_SKIP_PREPARE=0
ROBITA_STOP_DOCKER=1
ROBITA_STOP_PIPELINE_PORTS=1
ROBITA_STOP_OLLAMA=1
ROBITA_CLEANUP_PROJECT=1
ROBITA_RAG_CONFIG=/opt/robita-lab/01_SERVICES/rag-engine/config/rag_config.jetson.json
HF_HOME=/opt/robita-lab/data/huggingface

# Audio — ReSpeaker Mic Array v2: mic + altavoz por el mismo USB
ROBITA_AUDIO_INPUT=respeaker
ROBITA_AUDIO_OUTPUT=respeaker
# ROBITA_PULSE_SOURCE=alsa_input.usb-SEEED_ReSpeaker_4_Mic_Array__UAC1.0_-00.multichannel-input
# ROBITA_PULSE_SINK=alsa_output.usb-SEEED_ReSpeaker_4_Mic_Array__UAC1.0_-00.analog-stereo

# Wakeword — openWakeWord
ROBITA_WAKEWORD_BACKEND=openwakeword
ROBITA_WAKEWORD=udito
ROBITA_WAKEWORD_MODEL=/opt/robita-lab/01_SERVICES/wakeword-engine/models/udito.onnx
# Demo temporal en inglés (di «hey jarvis» en voz alta):
# ROBITA_WAKEWORD="hey jarvis"
# ROBITA_WAKEWORD_MODEL=/opt/robita-lab/01_SERVICES/wakeword-engine/models/openwakeword/hey_jarvis_v0.1.onnx
# Umbral demo mic (udito ~0.25–0.35; hey jarvis ~0.04)
# ROBITA_DEMO_WW_THRESHOLD=0.30

# TTS Piper — preset supersonic_m5 (carlfm x_low, rápida, ligera en Jetson)
# ROBITA_TTS_CONFIG=/opt/robita-lab/01_SERVICES/tts-engine/config/tts_config.json
# 0 = consola limpia; 1 = log detallado (Hugging Face, embeddings, etc.)
ROBITA_VERBOSE=0
# Risa tras chiste: sonido sintetico. Opcional: ruta a laugh.mp3 / laugh.wav
# ROBITA_LAUGH_SOUND=/opt/robita-lab/03_ADAPTERS/robot-udit-physical/assets/audio/laugh.mp3
CUDA_VISIBLE_DEVICES=
