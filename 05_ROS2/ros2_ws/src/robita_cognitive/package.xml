<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robita_cognitive</name>
  <version>0.1.0</version>
  <description>Capa cognitiva de ROBITA (RAG + LLM): servidor de la acción Think y adaptador a /udito/cognitive/*. La lógica vive en robita_cognitive.core, Python puro sin ROS.</description>
  <maintainer email="luis.penya@udit.es">Luis-Pena-Udit</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>robita_interfaces</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
