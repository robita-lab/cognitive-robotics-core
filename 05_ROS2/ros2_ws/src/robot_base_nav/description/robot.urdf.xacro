<?xml version="1.0"?>
<robot name="robot_base" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ============== Parámetros geométricos (AJUSTAR a tu robot real) ============== -->
  <xacro:property name="wheel_radius" value="0.08"/>
  <xacro:property name="wheel_separation" value="0.40"/>
  <xacro:property name="wheel_width" value="0.05"/>
  <xacro:property name="base_length" value="0.53"/>
  <xacro:property name="base_width" value="0.40"/>
  <xacro:property name="base_height" value="0.08"/>

  <material name="gris"><color rgba="0.6 0.6 0.6 1.0"/></material>
  <material name="negro"><color rgba="0.1 0.1 0.1 1.0"/></material>

  <!-- ============== base_link ============== -->
  <link name="base_link">
    <visual>
      <geometry><box size="${base_length} ${base_width} ${base_height}"/></geometry>
      <material name="gris"/>
    </visual>
    <collision>
      <geometry><box size="${base_length} ${base_width} ${base_height}"/></geometry>
    </collision>
    <inertial>
      <mass value="2.0"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
    </inertial>
  </link>

  <!-- ============== Ruedas ============== -->
  <xacro:macro name="wheel" params="prefix reflect">
    <link name="wheel_${prefix}_link">
      <visual>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
        <origin rpy="1.5708 0 0" xyz="0 0 0"/>
        <material name="negro"/>
      </visual>
      <collision>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
        <origin rpy="1.5708 0 0" xyz="0 0 0"/>
      </collision>
      <inertial>
        <!--mass value="0.2"/-->
        <mass value="5"/>
        <inertia ixx="0.0005" ixy="0" ixz="0" iyy="0.0005" iyz="0" izz="0.0005"/>
      </inertial>
    </link>

    <joint name="wheel_${prefix}_joint" type="continuous">
      <parent link="base_link"/>
      <child link="wheel_${prefix}_link"/>
      <origin xyz="0 ${reflect * wheel_separation / 2.0} 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <xacro:wheel prefix="left" reflect="1"/>
  <xacro:wheel prefix="right" reflect="-1"/>

  <!-- ============== Lidar ============== -->
  <!-- El driver ldlidar_node publica por su cuenta ldlidar_base -> ldlidar_link.
       Aquí solo definimos dónde va montado el lidar respecto al centro del robot.
       AJUSTAR xyz a tu montaje real. -->
  <link name="ldlidar_base"/>

  <joint name="ldlidar_base_joint" type="fixed">
    <parent link="base_link"/>
    <child link="ldlidar_base"/>
    <!--origin xyz="0.08 0 0.10" rpy="0 0 0"/-->
    <origin xyz="0.05 0 0.12" rpy="0 0 0"/>
  </joint>

</robot>
