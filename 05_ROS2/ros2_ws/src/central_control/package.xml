<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>central_control</name>
  <version>0.2.0</version>
  <description>Arquitectura híbrida - UDITO · Control central (C.C.): reconoce órdenes y reparte voz, cara y cuerpo; consola del operador, ejemplo del cuerpo y capa cognitive.</description>
  <maintainer email="dguevaras@hotmail.com">Danilo Guevara</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
